
#include <WiFi.h>

// Identifiants de votre réseau Wi-Fi
const char* ssid = "NOM_DE_VOTRE_WIFI";
const char* password = "MOT_DE_PASSE_WIFI";

void setup() {

  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("===== TEST WIFI ESP32-C5 =====");

  // Connexion au réseau Wi-Fi
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("Connexion au Wi-Fi");

  int tentatives = 0;

  // Attendre au maximum 20 secondes
  while (WiFi.status() != WL_CONNECTED && tentatives < 20) {
    delay(1000);
    Serial.print(".");
    tentatives++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("Connexion Wi-Fi reussie !");

    Serial.print("Adresse IP : ");
    Serial.println(WiFi.localIP());

    Serial.print("Puissance du signal (RSSI) : ");
    Serial.print(WiFi.RSSI());
    Serial.println(" dBm");

  } else {

    Serial.println("Echec de connexion au Wi-Fi !");
    Serial.print("Code Wi-Fi : ");
    Serial.println(WiFi.status());

  }
}

void loop() {

  // Afficher l'etat de la connexion toutes les 5 secondes
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Wi-Fi toujours connecte");
  } else {
    Serial.println("Wi-Fi deconnecte !");
  }

  delay(5000);
}
